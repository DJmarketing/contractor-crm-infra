# Copy to .env on the server and fill in. DO NOT commit .env to git.

# ---- Image tag ----
# Default is "latest" — pulls the newest image from ghcr.io/djmarketing/contractor-crm.
# For prod stability, pin to a specific commit SHA from your GitHub Actions build:
#   TAG=07a4b945f2e1234567890abcdef1234567890abcd
TAG=latest

# ---- Public URL ----
# Single-workspace: set to the exact URL users hit, e.g. https://app.contractor-crm.com
# Multi-workspace: set to the APEX (https://contractor-crm.com). Twenty prepends
#   DEFAULT_SUBDOMAIN, so the default workspace lands at https://app.contractor-crm.com.
SERVER_URL=https://contractor-crm.com

# ---- Multi-workspace (one subdomain per workspace) ----
# Requires wildcard DNS (*.contractor-crm.com) AND a wildcard TLS cert (handled by
# the custom Caddy build + Cloudflare DNS-01 below). Leave false for single-workspace.
IS_MULTIWORKSPACE_ENABLED=true
DEFAULT_SUBDOMAIN=app

# ---- Cloudflare API token (for Caddy DNS-01 wildcard cert) ----
# Create at Cloudflare → My Profile → API Tokens → Create Token.
# Permissions: Zone : DNS : Edit, scoped to the contractor-crm.com zone.
CLOUDFLARE_API_TOKEN=

# ---- Secrets ----
# Generate with: openssl rand -base64 32   (any chars are fine for these)
ENCRYPTION_KEY=
# Leave blank unless rotating the key.
FALLBACK_ENCRYPTION_KEY=

# ---- Postgres ----
# IMPORTANT: password is interpolated into a URL, so use URL-safe chars only.
# Generate with: openssl rand -hex 24   (do NOT use base64 here — / + = break the URL)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=

# ---- Hetzner Object Storage (S3-compatible) ----
# Create a bucket in Hetzner Cloud Console → Object Storage.
# Endpoint format: https://<location>.your-objectstorage.com  (e.g. fsn1, nbg1, hel1)
STORAGE_S3_REGION=fsn1
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ---- SMTP (required for password resets / invites) ----
# Resend / Postmark / SES / Mailgun all work. Example uses Resend.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Your CRM"
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# ---- Optional: Google OAuth / Gmail / Calendar ----
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# ---- Optional: Microsoft OAuth / Outlook / Calendar ----
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
