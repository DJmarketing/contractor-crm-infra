# Copy to .env on the server and fill in. DO NOT commit .env to git.

# ---- Twenty version (pin, don't use latest in prod) ----
# Check https://hub.docker.com/r/twentycrm/twenty/tags for the latest published tag.
TAG=v2.7.3

# ---- Public URL ----
# Must match exactly how users reach the app in the browser.
SERVER_URL=https://app.contractor-crm.com

# ---- Secrets ----
# Generate with: openssl rand -base64 32   (any chars are fine for these)
ENCRYPTION_KEY=
# Leave blank unless rotating the key.
FALLBACK_ENCRYPTION_KEY=

# ---- Postgres ----
# IMPORTANT: password is interpolated into a URL, so use URL-safe chars only.
# Generate with: openssl rand -hex 24   (do NOT use base64 here — / + = break the URL)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=

# ---- Hetzner Object Storage (S3-compatible) ----
# Create a bucket in Hetzner Cloud Console → Object Storage.
# Endpoint format: https://<location>.your-objectstorage.com  (e.g. fsn1, nbg1, hel1)
STORAGE_S3_REGION=fsn1
STORAGE_S3_NAME=
STORAGE_S3_ENDPOINT=https://fsn1.your-objectstorage.com
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# ---- SMTP (required for password resets / invites) ----
# Resend / Postmark / SES / Mailgun all work. Example uses Resend.
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME="Your CRM"
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# ---- Optional: Google OAuth / Gmail / Calendar ----
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# ---- Optional: Microsoft OAuth / Outlook / Calendar ----
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
